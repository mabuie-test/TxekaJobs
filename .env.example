APP_NAME="Txeka Jobs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=txekajobs
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@txekajobs.local"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_GATEWAY_DRIVER=mock
MPESA_ENV=sandbox
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_INITIATOR_IDENTIFIER=
MPESA_SECURITY_CREDENTIAL=
MPESA_DEFAULT_SHORTCODE=
MPESA_CALLBACK_URL="${APP_URL}/api/pagamentos/mpesa/callback"
RESERVA_PERCENTUAL_PADRAO=0.2
VALOR_LEAD_PADRAO=50

# Admin bootstrap
ADMIN_REGISTRATION_TOKEN=
